<%-
  # Every OOD session runs in the interactive QOS, whatever the partition. Its limits come
  # from Slurm (qos_limits.rb); submit.yml.erb checks them again with a clear message.
  load File.join(File.dirname(__FILE__), "qos_limits.rb")
  qos = RemoteDesktopQos.limits
  used = RemoteDesktopQos.usage
  in_use = "Your #{used[:jobs]} running or queued session(s) already use " \
           "#{used[:cpu]} cores, #{used[:mem_gb]} GB and #{used[:gpu]} GPUs."
-%>
---
cluster: "cbe"
# The submit rules on CBE.next add: sessions on m need at least 128 GB, sessions on g a GPU.
attributes:
  # Not cached: a value cached from an older form would override a new image.
  # Symlink to the current ghcr.io/clip-hpc/ood-desktop release (CLIP-HPC/ood-desktop-image).
  container_image:
    widget: "hidden_field"
    value: "/software/ood/desktop/ood-desktop.sif"
    cacheable: false
  # Admins can test another image; submit.yml.erb checks the group again, since a hidden
  # field can still be posted.
  desktop_container:
    widget: '<%= CurrentUser.group_names.include?("perm.cbe.users.admin") ? "text_field" : "hidden_field" %>'
    label: "Container image (admins only)"
    help: |
      Path to an Apptainer image (SIF) to run instead of `/software/ood/desktop/ood-desktop.sif`,
      for testing an image. Leave empty for the default.
    value: ""
    cacheable: false
  # A plain select, not auto_queues: auto_queues ignores options and lists every partition.
  # form.js shows the GPU fields only on g and enforces the 128 GB minimum on m.
  partition:
    widget: "select"
    label: "Partition"
    help: |
      CPU (c) for most work. GPU (g) adds a GPU to the desktop (CUDA, no 3D
      acceleration yet). High memory (m) needs at least 128 GB memory.
    value: "c"
    options:
      - ["CPU (c)", "c"]
      - ["GPU (g)", "g"]
      - ["High memory (m)", "m"]
  # Values are Slurm GRES types (sinfo -p g -o %G). MIG slices are CUDA-only.
  gpu_type:
    widget: "select"
    label: "GPU type"
    help: "Only shown when the GPU (g) partition is selected."
    value: "nvidia_b200_1g.23gb"
    options:
      - ["B200 MIG slice, 23 GB", "nvidia_b200_1g.23gb"]
      - ["A100 MIG slice, 20 GB", "nvidia_a100_3g.20gb"]
      - ["Quadro RTX 6000, 24 GB", "quadro_rtx_6000"]
      - ["A100, 40 GB", "nvidia_a100-sxm4-40gb"]
      - ["B200, 180 GB", "nvidia_b200"]
  gpu_count:
    widget: "number_field"
    label: "Number of GPUs"
    help: |
      At most <%= qos[:gpu] %> GPUs over all your desktop and other OnDemand sessions
      together. <%= in_use %>
    value: 1
    min: 1
    max: <%= qos[:gpu] %>
    step: 1
  cores:
    widget: "number_field"
    label: "CPU cores"
    help: |
      At most <%= qos[:cpu] %> cores over all your OnDemand sessions together.
      <%= in_use %>
    value: 4
    min: 1
    max: <%= qos[:cpu] %>
    step: 1
  ram:
    widget: "number_field"
    label: "Memory (GB)"
    help: |
      At least 128 GB on the high memory (m) partition. At most <%= qos[:mem_gb] %> GB
      over all your OnDemand sessions together.
    value: 16
    min: 1
    max: <%= qos[:mem_gb] %>
    step: 1
  bc_num_hours:
    widget: "number_field"
    label: "Hours"
    help: |
      OnDemand sessions can run for at most <%= qos[:hours] %> hours, on every partition.
      For longer work, submit a batch job with `sbatch` from a login node: batch jobs
      can run for up to 14 days.
    value: 8
    min: 1
    max: <%= qos[:hours] %>
    step: 1
  bc_email_on_started: ""
form:
  - container_image
  - partition
  - gpu_type
  - gpu_count
  - cores
  - ram
  - bc_num_hours
  - bc_email_on_started
  - desktop_container
