<%-
  # Every OOD session runs in the interactive QOS, whatever the partition. Its limits come
  # from Slurm (qos_limits.rb); submit.yml.erb checks them again with a clear message.
  load File.join(File.dirname(__FILE__), "qos_limits.rb")
  qos = RemoteDesktopQos.limits
  used = RemoteDesktopQos.usage
  in_use = "Your #{used[:jobs]} running or queued session(s) already use " \
           "#{used[:cpu]} cores, #{used[:mem_gb]} GB and #{used[:gpu]} GPUs."

  # Partitions and GPU types this cluster has (cluster_info.rb): orion has only c
  load File.join(File.dirname(__FILE__), "cluster_info.rb")
  partitions = RemoteDesktopCluster.partitions
  gpus = RemoteDesktopCluster.gpus(partitions)
  partition_help = {
    "c" => "CPU (c) for most work.",
    "g" => "GPU (g) adds a GPU to the desktop (CUDA, no 3D acceleration yet).",
    "m" => "High memory (m) needs at least 128 GB memory."
  }.values_at(*partitions).join(" ")
-%>
---
cluster: "cbe"
# The submit rules on CBE.next add: sessions on m need at least 128 GB, sessions on g a GPU.
# The image isn't a form field: submit.yml.erb sets it, so it can't be posted.
attributes:
  # Admins can test another image; submit.yml.erb checks the group again, since a hidden
  # field can still be posted.
  desktop_container:
    widget: '<%= CurrentUser.group_names.include?("perm.cbe.users.admin") ? "text_field" : "hidden_field" %>'
    label: "Container image (admins only)"
    help: |
      Path to an Apptainer image (SIF) to run instead of `/software/ood/desktop/ood-desktop.sif`,
      for testing an image. Leave empty for the default.
    value: ""
    cacheable: false
  # A plain select, not auto_queues: auto_queues ignores options and lists every partition.
  # form.js shows the GPU fields only on g and enforces the 128 GB minimum on m.
  partition:
    widget: "select"
    label: "Partition"
    help: "<%= partition_help %>"
    value: "<%= partitions.include?("c") ? "c" : partitions.first %>"
    options:
    <%- partitions.each do |p| -%>
      - <%= [RemoteDesktopCluster::PARTITIONS[p], p].to_json %>
    <%- end -%>
<%- unless gpus.empty? -%>
  # Values are Slurm GRES types from sinfo -p g -o %G. data-max-gpus is the most GPUs of
  # the type on one node, capped by the QOS; form.js sets the GPU count maximum from it.
  gpu_type:
    widget: "select"
    label: "GPU type"
    help: "Only shown when the GPU (g) partition is selected. MIG slices are CUDA-only."
    value: "<%= gpus.key?("nvidia_b200_1g.23gb") ? "nvidia_b200_1g.23gb" : gpus.keys.first %>"
    options:
    <%- gpus.each do |type, per_node| -%>
      - <%= [RemoteDesktopCluster.gpu_label(type), type, { "data-max-gpus" => [per_node, qos[:gpu]].min }].to_json %>
    <%- end -%>
  gpu_count:
    widget: "number_field"
    label: "Number of GPUs"
    help: |
      At most <%= qos[:gpu] %> GPUs over all your desktop and other OnDemand sessions
      together, and no more than one node has of the chosen type. <%= in_use %>
    value: 1
    min: 1
    max: <%= qos[:gpu] %>
    step: 1
<%- end -%>
  cores:
    widget: "number_field"
    label: "CPU cores"
    help: |
      At most <%= qos[:cpu] %> cores over all your OnDemand sessions together.
      <%= in_use %>
    value: 4
    min: 1
    max: <%= qos[:cpu] %>
    step: 1
  ram:
    widget: "number_field"
    label: "Memory (GB)"
    help: |
      <%= partitions.include?("m") ? "At least 128 GB on the high memory (m) partition. " : "" %>At most <%= qos[:mem_gb] %> GB
      over all your OnDemand sessions together.
    value: 16
    min: 1
    max: <%= qos[:mem_gb] %>
    step: 1
  bc_num_hours:
    widget: "number_field"
    label: "Hours"
    help: |
      OnDemand sessions can run for at most <%= qos[:hours] %> hours, on every partition.
      For longer work, submit a batch job with `sbatch` from a login node: batch jobs
      can run for up to 14 days.
    value: 8
    min: 1
    max: <%= qos[:hours] %>
    step: 1
  bc_email_on_started: ""
form:
  - partition
<%- unless gpus.empty? -%>
  - gpu_type
  - gpu_count
<%- end -%>
  - cores
  - ram
  - bc_num_hours
  - bc_email_on_started
  - desktop_container
